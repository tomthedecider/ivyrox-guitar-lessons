# Postgres connection string. See the root README's "Persistence" section
# for how to get one for free (Neon, ~1 minute, no local install).
DATABASE_URL="postgresql://user:password@host/dbname"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGIN="http://localhost:5173"
