# SQLite (default, zero-setup local dev)
DATABASE_URL="file:./dev.db"

# To use Postgres instead, point this at your instance and switch the
# datasource provider in prisma/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/ivyrox"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGIN="http://localhost:5173"
